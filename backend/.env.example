# Server Configuration
PORT=5000
NODE_ENV=development

# Public Base URL for generated short links (no trailing slash)
BASE_URL=http://localhost:5000

# Database Configuration
# Local MongoDB example: mongodb://127.0.0.1:27017/linklite
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/linklite?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/linklite

# Client / CORS Configuration
# Comma-separated list or single URL for allowed frontend origin(s)
CLIENT_ORIGIN=http://localhost:5173

# Reverse Proxy / Load Balancer Configuration (Optional)
# Set to 1 (or true) when running behind a reverse proxy (e.g., Nginx, Cloudflare, AWS ALB, Render)
# to correctly resolve client IP addresses for rate limiting and logging.
# TRUST_PROXY=1

